# Copy this to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ----- Supabase (Phase 2) -----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Shopify (Phase 3) -----
SHOPIFY_STORE_DOMAIN=whencecameyouniversity.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
# Custom app Admin API token with write_draft_orders scope. Required for /api/donate custom-amount path.
SHOPIFY_ADMIN_API_TOKEN=

