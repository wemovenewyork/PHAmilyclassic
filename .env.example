# Copy this to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ----- Supabase (Phase 2) -----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Shopify (Phase 3) -----
SHOPIFY_STORE_DOMAIN=whencecameyouniversity.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
# Custom app Admin API token with write_draft_orders scope. Required for /api/donate custom-amount path.
SHOPIFY_ADMIN_API_TOKEN=

# ----- Resend (ticket email) -----
RESEND_API_KEY=
RESEND_FROM_EMAIL=tickets@send.whencecameyouniversity.com
RESEND_REPLY_TO=whencecameyouniversity@gmail.com

# ----- Scanner (PR #19) -----
# Shared password for the event-day scanner login. HMAC-signed session
# cookie expires Aug 29 2026 23:59 EDT.
SCANNER_PASSWORD=
# Optional: 32+ char random hex. If unset, the cookie signing key falls
# back to a derived hash of SCANNER_PASSWORD with a startup warning.
SCANNER_COOKIE_SECRET=

# ----- Admin dashboard (PR #20) -----
# JWT signing secret for the admin session cookie. 32+ random chars.
# Required — admin login fails if this is unset or too short.
ADMIN_SESSION_SECRET=
